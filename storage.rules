rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Coach permanente — mismo email que en firestore.rules.
    // email_verified evita que una cuenta email/password sin verificar se
    // autoproclame coach o dueño de un email ajeno (auditoría 2026-07-23).
    function isCoach() {
      return request.auth != null
          && request.auth.token.email == 'danitrviner@gmail.com'
          && request.auth.token.email_verified == true;
    }

    function isOwnerEmail(email) {
      return request.auth != null
          && request.auth.token.email == email
          && request.auth.token.email_verified == true;
    }

    // ── progressPhotos/{email}/{date}_{view} — fotos de progreso corporal ────
    // Antes de esta regla, cualquier usuario autenticado podía leer/escribir/
    // borrar las fotos de CUALQUIER atleta (allow read, write: if request.auth
    // != null a nivel global). Es el dato más sensible de la app — solo su
    // dueño y el coach pueden acceder.
    match /progressPhotos/{email}/{fileName} {
      allow read: if isCoach() || isOwnerEmail(email);
      allow write: if isOwnerEmail(email)
                   && fileName.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_(front|side|back)')
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isCoach() || isOwnerEmail(email);
    }

    // ── gymPhotos/{email}/{fileName} — fotos de máquinas propias del atleta ──
    // El atleta fotografía una máquina de su gimnasio que no está en el catálogo.
    // No es dato sensible como las fotos de progreso, pero se acota igual al dueño
    // y al coach: no hay razón para que un atleta vea el gimnasio de otro.
    match /gymPhotos/{email}/{fileName} {
      allow read: if isCoach() || isOwnerEmail(email);
      allow write: if isOwnerEmail(email)
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isCoach() || isOwnerEmail(email);
    }

    // ── maquinas/{fileName} — imágenes del catálogo subidas por el admin ─────
    // Las del scraping van en public/ (CDN, coste cero); aquí solo caen las que
    // el admin sustituye o añade a mano. Lectura pública autenticada: son fotos
    // de producto, las ve todo el que recorre el catálogo.
    match /maquinas/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if isCoach();
    }

    // ── questionnaireMedia/{email}/{fileName} — fotos/vídeos de respuestas de
    // cuestionario (preguntas tipo 'media', ej. corrección de ejercicios en
    // vídeo). Mismo patrón de ownership que progressPhotos. Tope duro de 50MB
    // en el servidor (QuestionnaireQuestion.maxSizeMb es solo un límite blando
    // sugerido al cliente).
    // 04-3: este bloque era el único que comparaba el email a mano en vez de
    // usar isOwnerEmail(), y por tanto el único que NO exigía email_verified.
    // Una cuenta registrada con el correo de un invitado que todavía no ha
    // entrado podía leer, sobrescribir y borrar sus vídeos y fotos. Es el mismo
    // agujero que se cerró en bodyMeasurements el 8 ago 2026, y quedaba aquí.
    match /questionnaireMedia/{email}/{fileName} {
      allow read: if isCoach() || isOwnerEmail(email);
      allow write: if isOwnerEmail(email)
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
      allow delete: if isCoach() || isOwnerEmail(email);
    }

    // Default deny — cualquier path no cubierto explícitamente arriba.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
