rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Coach permanente — mismo email que en firestore.rules.
    // email_verified evita que una cuenta email/password sin verificar se
    // autoproclame coach o dueño de un email ajeno (auditoría 2026-07-23).
    function isCoach() {
      return request.auth != null
          && request.auth.token.email == 'danitrviner@gmail.com'
          && request.auth.token.email_verified == true;
    }

    function isOwnerEmail(email) {
      return request.auth != null
          && request.auth.token.email == email
          && request.auth.token.email_verified == true;
    }

    // ── progressPhotos/{email}/{date}_{view} — fotos de progreso corporal ────
    // Antes de esta regla, cualquier usuario autenticado podía leer/escribir/
    // borrar las fotos de CUALQUIER atleta (allow read, write: if request.auth
    // != null a nivel global). Es el dato más sensible de la app — solo su
    // dueño y el coach pueden acceder.
    match /progressPhotos/{email}/{fileName} {
      allow read: if isCoach() || isOwnerEmail(email);
      allow write: if isOwnerEmail(email)
                   && fileName.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_(front|side|back)')
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isCoach() || isOwnerEmail(email);
    }

    // Default deny — cualquier path no cubierto explícitamente arriba.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
