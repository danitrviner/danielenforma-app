<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget de bloqueo (§6.1): notificación persistente con la cuenta
             atrás del descanso, sobrevive a la app en segundo plano. -->
        <service android:name=".RestTimerService" android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cuenta atrás de descanso durante el entrenamiento"
            />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Banda BLE de frecuencia cardíaca (§4.2 del plan) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 02-12. @capacitor-community/bluetooth-le declara ACCESS_FINE_LOCATION en
         SU manifiesto, y el merge lo arrastraba al nuestro sin `maxSdkVersion`.
         Efecto: Play te obliga a rellenar la declaración de permisos de
         ubicación y a declarar recogida de ubicación en Data safety, para una
         app que no usa la ubicación para nada. Nosotros ya escaneamos con
         `neverForLocation`, así que en API 31+ no hace falta — pero el minSdk es
         24, y entre 24 y 30 el sistema SÍ exigía ubicación para poder escanear
         BLE. Por eso no se borra: `tools:node="replace"` sustituye el elemento
         del plugin entero por el nuestro, acotado con `maxSdkVersion="30"`.
         Borrarlo a secas dejaría la banda de pulso sin funcionar en Android
         7-11. Verificar con:
           ./gradlew :app:processReleaseManifest
         y leer app/build/intermediates/merged_manifests/release/AndroidManifest.xml -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" tools:node="replace" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" tools:node="replace" />

    <!-- Notificación persistente del descanso / Android 13+ (§6.1, §14) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>
